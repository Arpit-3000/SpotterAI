      "name": "1. New York to Chicago (Single Stop)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Chicago, IL\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/route/fuel-plan/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "route",
            "fuel-plan",
            ""
          ]
        },
        "description": "Calculates route from New York, NY to Chicago, IL (~790 miles), selecting cost-effective fuel stops within the 500-mile vehicle range."
      },
      "response": []
    },
